{
  "name": "@veryan/lit-spa",
  "version": "0.4.2",
  "license": "MIT",
  "description": "A lib for using lit.dev as an Single Page Application",
  "author": "Veryan Goodship",
  "homepage": "https://veryan.ca",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Veryan4/lit-spa.git"
  },
  "bugs": {
    "url": "https://github.com/Veryan4/lit-spa/issues"
  },
  "keywords": [
    "webcomponent",
    "lit",
    "ts",
    "typescript",
    "spa"
  ],
  "main": "./dist/lib/lit-spa.js",
  "module": "./dist/lib/lit-spa.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/lit-spa.js"
    },
    "./router": {
      "types": "./dist/lib/entries/router.d.ts",
      "import": "./dist/lib/router.js"
    },
    "./http": {
      "types": "./dist/lib/entries/http.d.ts",
      "import": "./dist/lib/http.js"
    },
    "./state": {
      "types": "./dist/lib/entries/state.d.ts",
      "import": "./dist/lib/state.js"
    },
    "./services": {
      "types": "./dist/lib/entries/services.d.ts",
      "import": "./dist/lib/services.js"
    },
    "./components": {
      "types": "./dist/lib/entries/components.d.ts",
      "import": "./dist/lib/components.js"
    }
  },
  "files": [
    "dist/lib"
  ],
  "scripts": {
    "dev": "vite --mode=dev",
    "build-lib": "tsc --project tsconfig.lib.json && vite build --mode lib",
    "build": "tsc --project tsconfig.demo.json && vite build",
    "lint": "eslint src",
    "format": "prettier . --write",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lit-labs/rollup-plugin-minify-html-literals": "^0.2.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.2",
    "@types/node": "^26.6.6",
    "@web/rollup-plugin-html": "4.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-wc": "^3.1.0",
    "highlight.js": "11.12.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-compression2": "2.5.4",
    "vite-plugin-dts": "5.1.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "lit": "3.3.3"
  }
}
